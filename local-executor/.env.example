# 方案A：本机 Mac 发布执行器配置（复制为 .env 并填写）
# API_BASE=163 后端地址（nginx 80）
# JWT_SECRET=163 backend/.env 的 JWT_SECRET（与 backend 共享 HS256 密钥）
# USER_ID=admin 用户 id（sub 声明）
# BROWSER_PROFILE_DIR=Playwright Chromium 持久化 profile（扫码登录态存这里）
# WORK_DIR=视频下载/截图工作目录
# POLL_INTERVAL=轮询秒数（常驻模式）
# AUTO_PUBLISH=true=自动点发表；false=停在待确认
# LOGIN_WAIT_SEC=未登录时等待扫码的最大秒数
API_BASE=http://192.168.1.163
JWT_SECRET=
USER_ID=
BROWSER_PROFILE_DIR=/Users/ben/.workbuddy/pw-publish-profile
WORK_DIR=/tmp/executor-work
POLL_INTERVAL=15
AUTO_PUBLISH=true
LOGIN_WAIT_SEC=150
