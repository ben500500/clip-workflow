      "type": "timeline",
      "name": "两个相邻短话题均需合并 (≥min_duration)",
      "tests": ["merge_short_adjacent", "duration_constraints"],
      "outline": [
        {"title": "男主隐瞒身份", "subtopics": ["假装穷小子"]},
