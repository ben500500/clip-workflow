# =============================================================================
# Clip Workflow - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置
# =============================================================================
# cp .env.example .env
# =============================================================================

# ==================== 通用配置 ====================
# 应用名称
APP_NAME=Clip Workflow
# 运行环境: development / production / testing
APP_ENV=development
# 调试模式
DEBUG=true
# 密钥（请务必修改为随机字符串）
SECRET_KEY=change-this-to-a-random-secret-key
# 允许的主机名（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== PostgreSQL 数据库 ====================
POSTGRES_DB=clipworkflow
POSTGRES_USER=clipworkflow
# 必填：请替换为强随机密码（如 openssl rand -base64 24）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# 必填：请与 POSTGRES_PASSWORD 保持一致
DATABASE_URL=postgresql+asyncpg://clipworkflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/clipworkflow

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
# 必填：请替换为强随机密码
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Redis 连接 URL（通用）
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0
# Celery 消息代理
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/1
# Celery 结果后端
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/2

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
# 必填：禁止使用默认值 minioadmin，必须替换为强随机值
MINIO_ROOT_USER=CHANGE_ME_STRONG_USER
# 必填：请替换为强随机密码
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# 必填：禁止使用默认值 minioadmin，必须替换为强随机值
MINIO_ACCESS_KEY=CHANGE_ME_STRONG_ACCESS_KEY
# 必填：请与 MINIO_ROOT_PASSWORD 保持一致
MINIO_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=clipworkflow
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

# ==================== 服务端口配置 ====================
NGINX_PORT=80
BACKEND_PORT=8001
FRONTEND_PORT=3000
AUTOCLIP_PORT=8000

# ==================== AutoClip 配置 ====================
# AutoClip 监听地址
AUTOCLIP_HOST=0.0.0.0
# AutoClip 工作模式: api / worker
AUTOCLIP_MODE=api
# 阿里云 DashScope API Key（用于 AI 剪辑 + Seedance 提示词生成 + 短剧发布素材生成）
DASHSCOPE_API_KEY=
# 默认 AI 模型
DEFAULT_AI_MODEL=qwen-vl-max
# AutoClip 实际调用的大模型（选点 + Seedance 提示词生成 + 发布素材生成 + 素材库出文案共用；docker-compose 默认 qwen-plus）
# ⚠️ 素材库（MiMo 在线网关 token-plan-cn）实测口径，11-03/11-04：
#   · `mimo-v2.5` 已被网关拒（400 `Unsupported model mimo-v2.5`）→ 出文案直接 502；
#   · 现用 **`mimo-v2.6-flash`**（11-04 定），`mimo-v2.6-pro` 同网关也可用，两者同一条
#     1333 字详规实测 93.6s / 96.2s 各回 3 条候选；
#   · MiMo 是**推理模型**：`API_MAX_TOKENS` 留默认 8192 时 reasoning 会把额度吃光、
#     content 回空，必须提到 32768；
#   · `API_TIMEOUT` 默认 240s，网关偶发卡流（实测连续两次 curl 28 超时），
#     建议 600；配合后端 `assets.py::_call_autoclip`（900s）与 nginx `proxy_read_timeout`（900s）
#     从外到内递减，素材库内部调用已把 autoclip 的重试压到 1 次。
API_MODEL_NAME=qwen-plus
API_MAX_TOKENS=32768
API_TIMEOUT=600
# 在线 LLM 网关 base_url（OpenAI 兼容），默认阿里 DashScope；切 Agnes 等网关时填写，如：
# LLM_API_BASE=https://apihub.agnes-ai.com/v1
# ASR 语音识别方式: aliyun_speech（默认，需 API Key） / whisper（本地 faster-whisper）
AUTOCLIP_ASR_METHOD=aliyun_speech
# ASR 字幕缓存复用开关（默认开启：同一视频再次 AI 选点直接复用转写结果，避免重复转写）
AUTOCLIP_ASR_CACHE=true
# ── Whisper GPU 加速（可选，三期效率优化） ──
# 使用 GPU 版镜像（docker build --build-arg ENABLE_CUDA=true）并启用 GPU overlay 时：
#   WHISPER_DEVICE=cuda、WHISPER_COMPUTE_TYPE=float16（RTX 2070 8G 建议 fp16，兼顾精度与显存）
# 纯 CPU 部署保持默认（cpu/int8），无需改动；无 GPU 环境自动回退不受影响。
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# ── 画面理解（Frame Analysis）配置：本地 Ollama 视觉模型（MiniCPM-V），默认关闭 ──
# 开启后 AI 选点 step3 评分时会抽帧分析画面（场景/动作/情绪/OCR/精彩度），补充纯文本判断的盲区
FRAME_ANALYSIS_ENABLED=false
# 画面理解视觉模型提供商：`ollama`（本地 MiniCPM-V，默认）/ `llm`（在线 OpenAI 兼容视觉模型，如 Agnes agnes-2.0-flash）
# 选择 `llm` 时需同时配置 LLM_API_KEY + FRAME_ANALYSIS_MODEL；在线不可用自动回退本地 Ollama
FRAME_ANALYSIS_PROVIDER=ollama
# 在线视觉模型 base_url（OpenAI 兼容 /chat/completions；默认 Agnes AI，可指向任意网关）
LLM_API_BASE=https://apihub.agnes-ai.com/v1
# 在线视觉模型 API Key（如 Agnes 密钥 sk-...；FRAME_ANALYSIS_PROVIDER=llm 时必填）
LLM_API_KEY=
# 在线视觉模型名（默认 Agnes 免费 agnes-2.0-flash，支持图片 URL 理解）
FRAME_ANALYSIS_MODEL=agnes-2.0-flash
# Ollama 服务地址（docker-compose 内为 ollama:11434；本地开发为 localhost:11434）
OLLAMA_HOST=http://ollama:11434
# 视觉模型名（openbmb/minicpm-v4.6 为 Q4 量化约 1.6GB 的官方模型）
OLLAMA_MODEL=openbmb/minicpm-v4.6
# 每候选片段最多抽几帧（默认 2：前 1/3 + 中段；帧越多越准但越慢，单帧 CPU 约 8-10s）
FRAME_ANALYSIS_PER_CLIP=2

# ==================== Celery 配置 ====================
# Celery Worker 并发数
CELERY_WORKER_CONCURRENCY=4
# Celery 任务序列化方式
CELERY_TASK_SERIALIZER=json
# Celery 结果序列化方式
CELERY_RESULT_SERIALIZER=json
# Celery 时区
CELERY_TIMEZONE=Asia/Shanghai
# 是否启用 Celery 定时任务
CELERY_BEAT_SCHEDULE_ENABLED=true

# =============== 解耦模式（AI 选点 × 切片解耦）配置 ===============
# 切片投递守护轮询「已选点池」间隔（秒）：解耦模式下，选点完成后
# 由 beat 周期扫描并将剧集投递到切片队列。
BATCH_DISPATCH_INTERVAL_SECONDS=5
# 批次状态聚合间隔（秒）：解耦模式下各剧集异步推进，由聚合器回填批次汇总。
BATCH_AGGREGATE_INTERVAL_SECONDS=10
# 开启解耦模式的批次需在 slice_config 中设置 pipeline_mode=decoupled
#（默认 serial 串行，保持历史行为，零影响）。

# ==================== 切片 Worker 配置 ====================
# 切片分发引擎：worker（Redis Stream / Go Worker）、local（单机同步执行）或 celery（回退）
SLICE_ENGINE=worker
# Worker 回调/上传 URL 的基础地址
# - 单机 Docker 部署：http://backend:8080（容器网络内）
# - 远程物理机部署：配置为后端可被 Worker 访问的地址，如 http://服务器IP:8001
WORKER_CALLBACK_BASE_URL=http://backend:8080
# Worker 节点 CPU 资源分配比例（%，默认 50）：切片时限制 ffmpeg 编码线程数，
# 避免切片任务占满整机 CPU，影响同机其它服务。1~100 之间取值。
CPU_PERCENT=50
# GPU 加速（可选，三期效率优化）：
# 部署机安装 NVIDIA 驱动 + nvidia-container-toolkit 后，用
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# 即可为 ollama（画面理解）/ autoclip（Whisper）/ slice-worker（NVENC 编码）透传 GPU。
# worker 启动时会自动检测本机 ffmpeg 硬件编码器并上报 encoder_capabilities（节点界面可见），
# 当前单机自动模式仅作能力展示；该字段为「GPU 节点自动分派」预留的接口。
# 节点专属队列开关（true/false，默认 true）：开启后服务器可指定派发任务直投某节点
ENABLE_DIRECT_QUEUE=true
# 节点专属队列 BRPOP 阻塞超时（秒，默认 2）：同时作为唤醒消息丢失时的兜底轮询周期
DIRECT_QUEUE_TIMEOUT=2
# Worker 任务超时（秒）
SLICE_TASK_TIMEOUT_SECONDS=7200
# Worker 失败重试次数
SLICE_WORKER_MAX_RETRIES=2
# Worker 失败重试延迟（秒）
SLICE_WORKER_RETRY_DELAY=30

# 素材变体去重（variant_service）运营开关：
# 常规配方 structural.reorder 默认值（默认开=带重排）。reorder 依赖拆段：
# 仅当 segment=True 且片段数≥3 时生效（对时域序列重排以拉开 L4 指纹）。
# 置 False 可关闭默认重排（segment 仍维持随机 [False,True] 不变）。
STRUCTURAL_REORDER_DEFAULT=true

# 素材变体去重 · BGM 音频差异化（配方分配层）：
# 在音频维度叠加弱背景音乐（BGM）拉稳 RMS 指纹距离，配合 engines/slice.py 的
# slice_segment 多输入 filter_complex 改造（bgm/bgm_volume/duck 三个入参）。
# BGM_ENABLED：总开关。因 slice_segment 多输入改造由 FFmpeg 侧 PR 落地，
#   在引擎侧合并前保持 false（纯配方层结构，向后兼容）；引擎就绪后置 true 生效。
# BGM_DIR：授权 BGM 素材目录（自产/CC0/明确商用授权源），空串=未配置。
#   配方层只从该目录挑选 source 并做授权校验（红线），杜绝非授权曲库入库。
# BGM_LICENSE_MANIFEST：可选授权清单 JSON（文件名->授权类型），未配置时按
#   "整目录视为已授权"兜底；配置后仅放行 cc0/self_produced/commercial 的文件。
# BGM_VOLUME：BGM 母音量（默认 0.35，弱背景、不压人声，与 FFmpeg bgm_volume 对齐）。
# BGM_MIX_RATIO：派生变体中采用 BGM 模式的比例（0~1，默认 0.4，其余走原音频模式池）。
BGM_ENABLED=false
BGM_DIR=
BGM_LICENSE_MANIFEST=
BGM_VOLUME=0.35
BGM_MIX_RATIO=0.4

# ==================== 日志配置 ====================
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=/app/logs/app.log
# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== 媒体文件配置 ====================
# 媒体文件存储方式: local / minio
MEDIA_STORAGE=minio
# 本地媒体文件路径（当 MEDIA_STORAGE=local 时使用）
MEDIA_DIR=/app/media
# 上传文件大小限制（字节）
MAX_UPLOAD_SIZE=524288000
# 支持的视频文件扩展名
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm
# 支持的音频文件扩展名
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.aac,.flac,.ogg

# ==================== CORS 配置 ====================
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1

# ==================== API 限流配置 ====================
# API 请求速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60
# 上传接口限流
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# ==================== RPA 自动发布配置 ====================
# Chrome 调试端口
CHROME_DEBUG_PORT=9222
# RPA 调试端口映射
RPA_DEBUG_PORT=9222
# 发布前是否需要人工确认
RPA_REQUIRE_MANUAL_CONFIRM=true
# 两次发布最小间隔（秒）
RPA_MIN_INTERVAL_SECONDS=300
# 每日最大发布数
RPA_MAX_DAILY_PUBLISH=20
# ==================== 安全认证（二期） ====================
# JWT 密钥（必填：必须改为随机强密钥，禁止使用占位值；缺失或占位会导致启动失败）
JWT_SECRET=change-this-to-a-random-jwt-secret
# access_token 有效期（分钟），默认 30
JWT_EXPIRE_MINUTES=30
# refresh_token 有效期（天），默认 7
JWT_REFRESH_EXPIRE_DAYS=7
# RPA Cookie 加密密钥（AES-256/Fernet），必须与 JWT_SECRET 不同；留空由后端启动时自动生成并落盘
COOKIE_ENCRYPT_KEY=
# 发布平台登录态巡检间隔（秒），默认 21600（每 6 小时）
COOKIE_CHECK_INTERVAL_SECONDS=21600

# ==================== 监控告警（三期） ====================
# 钉钉机器人 Webhook 地址（用于推送告警消息），留空则不推送
DINGTALK_WEBHOOK=
# 告警轮询间隔（秒），默认 300
ALERT_CHECK_INTERVAL_SECONDS=300

# ==================== 性能优化（三期） ====================
# 数据归档：video_metrics 等看板数据超过该天数自动归档（默认 90）
METRICS_ARCHIVE_DAYS=90
# MinIO 生命周期：对象未访问超过该天数转低频存储（默认 90）
MINIO_LIFECYCLE_DAYS=90

# ==================== 去水印功能（v4） ====================
# 去水印输出存储桶（处理后视频）
MINIO_BUCKET_WATERMARK=watermark-output
# 去水印源视频存储桶
MINIO_BUCKET_WATERMARK_RAW=watermark-raw
# remove-ai-watermarks CLI 可执行文件（pip 安装后为 remove-ai-watermarks）
WATERMARK_RAIW_CLI=remove-ai-watermarks
# Seedance 去水印脚本文件名（位于 ENGINES_DIR 下；容器内 /app/engines/seedance_watermark_remover.py）
WATERMARK_SEEDANCE_SCRIPT=seedance_watermark_remover.py
# seedance_wm（remover 仓库 5 阶段流水线）执行入口脚本（位于 ENGINES_DIR 下）
WATERMARK_SEEDANCE_WM_SCRIPT=seedance_wm_runner.py

# ==================== 短片制作：一键豆包生成 ====================
# 豆包账户类型时长上限（秒），可在 system_config 的 shortdrama_doubao_config 中覆盖：
# - free：免费用户单次生成上限 10s
# - pro：包月会员（Seedance 2.5）单次生成上限 30s
# 用户选择账户类型后即作为当前登录用户的默认值（users.doubao_account_type）
DOUBAO_FREE_MAX_SECONDS=10
DOUBAO_PRO_MAX_SECONDS=30

# ==================== 短片制作：Seedance 官方 API 直连出片 ====================
# 与豆包 RPA 并行、完全独立的第二出片通道（火山方舟官方 API，HTTP 直连、无浏览器/扫码）。
# 总开关（默认关闭）：开启后短片制作「提示词生成历史」出现「Seedance 生成」按钮，
# 走官方 API 直连出片；也可在 system_config 的 shortdrama_seedance_config.enabled 覆盖。
# 注意：两套方案逻辑隔离，开关切换不会弄混；成片统一回填 video_* 字段，下游零感知。
SEEDANCE_ENABLED=false
# 火山方舟 API Key（https://console.volcengine.com/ark），建议仅存环境变量，勿入库
SEEDANCE_API_KEY=
# 模型名或推理接入点 ID（ep-xxx）。Seedance 1.0 仅支持 5s/10s
SEEDANCE_MODEL=seedance-1-0-pro-250528
# API Base（默认即可）
SEEDANCE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 出片分辨率：480p / 720p / 1080p
SEEDANCE_RESOLUTION=1080p
# 是否加水印（建议 true，避免被平台判搬运）
SEEDANCE_WATERMARK=true
# 生成超时（秒）
SEEDANCE_TIMEOUT=600
# 时长超 10s 的处理策略：truncate(截成10s) / block(拒绝并提示)
SEEDANCE_LONG_DURATION_POLICY=truncate
# 每日配额（0=不限）
SEEDANCE_DAILY_QUOTA=0

# ═══════════════════════════════════════════════════════════════
# 视频号素材导入下载（wechat_download，立项决策④：独立配置命名空间）
# ═══════════════════════════════════════════════════════════════
# 元宝解析接口基础地址（非公开接口；P0 主链路）
WECHAT_DL_YUANBAO_API_BASE=https://yuanbao.tencent.com
# 元宝解析接口 Key / 鉴权 Token（如接口需独立 Key，生产必须配置）
WECHAT_DL_YUANBAO_KEY=
# 预览层兜底：视频号预览页前缀（复用已有登录态）
WECHAT_DL_PREVIEW_BASE=https://channels.weixin.qq.com
# 拉流层：finder 拉流基础地址
WECHAT_DL_FINDER_BASE=https://finder.video.qq.com
# 下载超时（秒，拉流整体超时）
WECHAT_DL_DOWNLOAD_TIMEOUT=600
# 独立 Celery 队列名（wechat_dl；剥离形态 B 可单独拉起 worker）
WECHAT_DL_QUEUE=wechat_dl
# 未指定 project_id 时的默认归属项目名
WECHAT_DL_DEFAULT_PROJECT=视频号导入
# 未授权是否允许预览式解析（False=硬拦截，满足 R1 合规红线）
WECHAT_DL_ALLOW_UNAUTH_PARSE=false
# 解析缓存有效期（秒，300~900，默认 600）：仅复用 TTL 内的成功解析记录。
# 腾讯签名直链 play_url 只活 1~3 小时，超期复用必然 direct download http 400，
# 因此 TTL 必须显著小于直链有效期；超期记录一律重新实时解析。
WECHAT_DL_PARSE_CACHE_TTL_SECONDS=600

# ── 资源下载页：API 服务商展示 / 充值入口 / 余量查询（可选）──
# 针对每个自定义 HTTP 服务商（WECHAT_DL_PROVIDERS 中的非内置名，如 zhiling/wxshares），
# 可用以下配置让「资源下载」页面展示服务商名称、充值官网，并实时查询剩余次数：
#   WECHAT_DL_<NAME>_HOME      — 充值/官网地址（如 https://www.17zhiling.com），不配则用 BASE 根域名
#   WECHAT_DL_<NAME>_DISPLAY   — 前端展示名称（如 “指令解析”），不配则用服务商名
#   WECHAT_DL_<NAME>_QUOTA_PATH   — 余量查询接口路径（如 /api/user/balance），不配则不查询余量
#   WECHAT_DL_<NAME>_QUOTA_METHOD — 余量查询方法（GET/POST，默认 GET）
#   WECHAT_DL_<NAME>_QUOTA_FIELD  — 余量字段（点分路径，默认 balance，如 data.remain_times）
#   WECHAT_DL_<NAME>_QUOTA_UNIT   — 余量单位（默认 次）
#   WECHAT_DL_<NAME>_QUOTA_PARAM  — 余量查询附加参数（JSON 字符串，可选，如 '{"key":"xxx"}'）
# 示例（zhiling，doc/107 视频去水印下载；展示元信息已内置，可用 env 覆盖）：
#   WECHAT_DL_ZHILING_DISPLAY=视频去水印下载
#   WECHAT_DL_ZHILING_HOME=https://api.17zhiling.com/doc/107
#   WECHAT_DL_ZHILING_DOC=https://api.17zhiling.com/doc/107
#   （QUOTA_* 三行别照抄 /api/user/balance —— 智令实测无余量接口，见下方「服务商兜底链」段的说明）

# ── 视频反推提示词（智令 doc/120 提交 + doc/119 轮询，异步接口）──
# 密钥复用 WECHAT_DL_ZHILING_KEY（与 doc/107 解析同一账号），无需另配 Key。
# 提交：POST {BASE}{SUBMIT_PATH}（form-urlencoded：key/videoUrl/maxDuration）→ data 为 taskId
# 轮询：GET  {BASE}{STATUS_PATH}?key=&taskId=（免费，建议 3~5s 一次）
#   data.schedule：WAIT_HANDLE/PROCESSING/SUCCESS/FAIL；SUCCESS 时 data.content 为提示词正文
#   code=-1 为业务异常（含额度耗尽），原因见 msg；计费 0.00054 元/秒（注册赠 30 次）
WECHAT_DL_ZHILING_PROMPT_BASE=https://api.17zhiling.com
WECHAT_DL_ZHILING_PROMPT_SUBMIT_PATH=/api/video-inference/parse-video-url-time
WECHAT_DL_ZHILING_PROMPT_STATUS_PATH=/api/video-inference/task-status
# 外部请求超时（秒）
WECHAT_DL_PROMPT_TIMEOUT=15
# 计时上限（秒，1~600）：**按这个上限计费**（约 0.00054 元/秒），不是按视频实际长度。
# 11-09 现网实测把默认从 600 降到 180：留空＝按 600 投＝每条 0.324 元，当天 7 条
# 「视频理解服务返回空结果」的失败白花了 2.268 元——失败也扣钱，上限就是单价。
# 想让长视频反推更稳可以调回 300/600，但要清楚那是「每条都按这个价买」。
WECHAT_DL_PROMPT_MAX_DURATION=180
# 轮询「查询不通」的容忍时长（秒，默认 3600＝1 小时）。
# 智令网关自己转发上游超时会回 code=500「转发请求失败: CURL请求失败: Operation timed out…」，
# 那是**查询链路**抖动、任务大概率还在跑——11-03 之前把它当终态失败，等于
# 「钱已扣（按 maxDuration）＋素材判死＋重跑再扣一次」。现在保持处理中继续轮，
# 连续抖动满本时长才收口判 failed（按提交时刻算，正常反推几十秒~几分钟就出结果）。
# 不需要配；只有想把收口提前/推后才改。
# WECHAT_DL_PROMPT_POLL_GIVEUP_SECONDS=3600

# 终态失败自动补投一次（默认开）。11-09 现网：智令回 schedule=FAIL＋errMsg
# 「视频理解服务返回空结果」，上游 2.7~3.2 秒就吐空，同一条链接换个时刻再投就成功——
# 这是上游读取抖动，不是链接坏了。旧逻辑只记 failed，一线得手动点重投（再扣一次钱、
# 还得自己盯）。现在：可重试的终态失败自动补投一次，**每条链接只补一次**（用
# retry_count 原子认领，防并发双扣），补投仍失败就停在 failed 并把 errMsg 白话原因给一线。
# 关掉＝只在界面手动重投。
# WECHAT_DL_PROMPT_AUTO_RETRY=true
# 补投时改用 doc/107 解析出的直链（默认开）。反推只吃「能被上游直接拉流的地址」，
# 分享链接要靠上游自己解析，失败率明显高；先花约 0.01 元解析成直链再投，
# 等于用一分钱换掉一次 0.16 元的空跑。解析失败/没配 key 时自动退回原链接，不报错。
# WECHAT_DL_PROMPT_RETRY_VIA_DIRECT=true
# 解析回来的地址过不过**形状闸门**（默认开）。现网事故：短剧导流页那类分享链接，智令
# doc/107「解析成功」回的却是它自己域名的站点根（https://vnd2.17zhilian.cn/），旧判据
# 「以 http 开头就收」把它当直链往下喂 → 下载原片存成 10KB 的 HTML、反推必然「未检测到
# 视频」、补投再花一次解析钱。开着＝站点根/网页文件/封面图一律白话拒收。
# 关掉只有一种理由：某个渠道确实回不带路径的直链，需要临时放行（判据细节见
# backend/wechat_download/url_gate.py）。
# WECHAT_DL_DIRECT_URL_SHAPE_GATE=true

# ── 反推提示词：本地视频上传（智令 doc/125 签名 → S3 temp 桶 → doc/120）──
# 没有可分享链接的视频走这条路：GET {BASE}{SIGN_PATH}?key=&fileName=&contentType=&expiresIn=
#   → data：uploadUrl / formFields（AWS4 签名字段）/ objectKey / fileUrl
#   再按 AWS S3 POST 直传（formFields 在前、file 最后），fileUrl 作为 doc/120 的 videoUrl。
# 文件落智令 temp 桶，6 小时后自动删除；上传计费 0.001 元/次（注册赠 100 次）
WECHAT_DL_ZHILING_UPLOAD_SIGN_PATH=/api/upload/signature
# 上传大小上限（MB）：前端预校验 + 后端 Content-Length/落盘双重硬校验
WECHAT_DL_PROMPT_UPLOAD_MAX_MB=500
# 上传超时下限（秒）：实际值 = max(该值, 文件MB * 6)
WECHAT_DL_PROMPT_UPLOAD_TIMEOUT=120

# ── 服务商兜底链 + 智令余量通道（素材库余额熔断的硬依赖，A1-1）──
# 有序 provider 链（逗号分隔）：内置名 yuanbao/preview，其余按 WECHAT_DL_<NAME>_BASE 建 HTTP 适配器。
WECHAT_DL_PROVIDERS=yuanbao,zhiling,preview
# 智令 HTTP 适配器基础地址（未配 BASE 时该 provider 会被 build_providers 跳过 → 余额永远查不到）
WECHAT_DL_ZHILING_BASE=https://api.17zhiling.com
# 智令账号 Key（doc/107 解析与 doc/120 反推共用同一账号）
WECHAT_DL_ZHILING_KEY=
# ⚠️ 素材库的「余额熔断」只认 zhiling 通道的余量。默认链 yuanbao,preview 两个适配器
# 都不实现 check_balance（恒回空）→ 余额恒为 None → 闸门恒判「放行 + 事后对账」，等于没闸。
#
# 【11-03 在 163 现网 clip-backend 容器内实测】智令**没有对外余量接口**：
# /api/user/balance、/api/user/info、/api/account/balance 等 12 个候选路径全部 HTTP 404，
# fetch_provider_balances() 实回 {}。公开文档只列了 doc/107 解析、doc/120 反推、doc/125 上传签名，
# 计费口径写在「计费优先级：全站会员 → 单独包月 → 次数包 → 点数计费 → 账户余额 → 免费额度」，
# 但没给查询余量的端点。所以这三行**默认不配**（不配 = 余额未知 = 放行 + 事后对账，是正确行为，不是故障）。
# 想在现网开这个闸，只有两条路：① 智令后续开放余量接口时按真实路径填；② 换成有余额接口的服务商。
# 单位要能折算到元（元/cny/rmb=1，点/点数=0.001——单价 0.00054 元/秒 == 0.54 点/秒，
# 见 wechat_download/prompt_client.py:12）；「次」换算不到元，后端按余额未知处理而不是硬比。
# 填了之前务必拿真实账单核一次返回值，别照抄这里的示例。
# WECHAT_DL_ZHILING_QUOTA_PATH=/api/user/balance
# WECHAT_DL_ZHILING_QUOTA_FIELD=data.balance
# WECHAT_DL_ZHILING_QUOTA_UNIT=点
# 备注：QUOTA_PATH 写相对路径现在会自动拼上面的 BASE，Key 也会按 auth 方式自动带上
# （11-03 前这两个都是坑：相对路径直接抛「URL 必须带协议」，Key 只有再抄一份进 QUOTA_PARAM 才生效）。

# ═══════════════════════════════════════════════════════════════
# 素材库（asset_library，设计方案 20261103 P0）
# ═══════════════════════════════════════════════════════════════
# 单批导入上限（条）：超过必须拆批，防一次粘 500 条链接把解析打爆
ASSET_IMPORT_BATCH_MAX=100
# 单批反推预算上限（元）：预估超过该值判 need_approval，需管理员放批或拆批
ASSET_BATCH_BUDGET_CAP=50.0
# 余额安全系数：预估成本 × 该系数 仍 ≤ 余额 才放行（余额接口有抖动，留余量）
ASSET_BALANCE_SAFETY_RATIO=1.2
# 反推计时上限默认档位（秒，可选 60/180/300/600）：默认 180，**前端一律不许默认 600**
# （600 档一条 0.324 元，100 条 32 元；180 档一条 0.097 元，够出钩子文案）
ASSET_PROMPT_MAX_DURATION=180
# 每条素材的钩子文案候选数（11-06 起：默认只出 1 条浓缩一句话；要对照再调大）
ASSET_HOOK_CANDIDATE_COUNT=1
# 风险词表现读缓存时长（秒）。词表存在 system_config.asset_risk_lexicon，
# 界面「风险词库」改完**最多等一个 TTL** 才被审核/投产/导出扫到；设 0＝每次都查库。
# 默认 300；改这个值不用发版，也不用重启（下一次读就生效）。
ASSET_RISK_LEXICON_TTL_SECONDS=300
# 单条过审文案默认/最大生产份数 N（N＝同一文案派生 N 条差异化提示词，非重复投喂）
ASSET_PRODUCE_DEFAULT_N=3
ASSET_PRODUCE_MAX_N=20
# 豆包单号每日可出片数（仅用于排产天数折算，不是硬限）
ASSET_DOUBAO_PER_ACCOUNT_PER_DAY=3
# 单次请求条数上限：反推/出文案都是同步等外部接口的，100 条串跑会挂到网关超时；
# P1 上队列后这两个上限交给队列，不由 HTTP 层扛。
ASSET_ANALYZE_MAX_PER_CALL=20
ASSET_SUMMARY_MAX_PER_CALL=10
# 时效直链缓存窗口（小时）：resolve 取到的直链在这窗口内免费回放，过期重取（0.01 元/次）
ASSET_PLAY_URL_TTL_HOURS=6

# ── 素材库 · 生产通道：企微自动化后台「创建 AI 视频」任务板（wework_aivideo）──
# 权威口径：NAS《每日解压视频-操作手册-20261022.md》＋ Drama/共享配置/skill/relax-video-pipeline。
# 这条通道不扣现金；payload 只有七键 tag/reqID/total/date/prompt/name/picDatas；
# **没有时长与分辨率参数**，成片恒 10.08s / 720×1280（提示词写"15 秒"不生效）。
# ⚠️ 板地址与 Basic Auth：11-04 第二轮审核（D-3）时它们是**零读取**的假旋钮（那版是人工投板，
#   后端从不连板），当时被删；11-05 批 H 做「自动投板」（POST /api/assets/productions/dispatch），
#   随客户端 app/services/aivideo_board.py **重新接线**，现在真的有代码读。
#   凭据只走环境变量，仓库不写明文；现网由运维本人填进 .env，部署的人不碰那一行、也不回显。
#   AIVIDEO_AUTH 留空＝自动投板没启用，投递口当场白话拒绝，导出＋人工投板的老路不受影响。
ASSET_BOARD_BASE_URL=http://mp.miwan.synology.me:8500
# 格式 "user:pass"（客户端自己 base64；板要 Basic base64(user:pass)，塞原文会 401）
AIVIDEO_AUTH=
# 三步的超时分开是因为失败成因不同：90s 到＝没投出去；60s 到＝只是查不到（不许判死）；
# 180s 到＝片子取不回（单子仍算投过）。
ASSET_BOARD_CREATE_TIMEOUT=90
ASSET_BOARD_READ_TIMEOUT=60
ASSET_BOARD_DOWNLOAD_TIMEOUT=180
# 投板后台任务的轮询：45 秒一轮、最多等 45 分钟。到期还没终态**不判失败**，
# 留在 queued/running，由人回写或再点一次回收（waiting≠fail，判死就是重复烧号池）。
ASSET_BOARD_POLL_INTERVAL=45
ASSET_BOARD_POLL_MAX_MINUTES=45
# 单次投递最多几张单（20 张≈当天号池 20 条，每张 board_total=1；再大请分批看结果）
ASSET_DISPATCH_MAX_PER_CALL=20
# 板上 tag＝拥有者标记：不填就建成无主任务、按天筛不到（回收必然漏）
ASSET_BOARD_TAG=suanku
# 板上 total＝同一条 prompt 出几版（接口层 1..20）。与 N 是两个量，别混用。
ASSET_BOARD_TOTAL_MAX=20
ASSET_BOARD_DEFAULT_TOTAL=1
# 号池实测 ≈120 条/日（1023 叠 240 → 115/120 全 fail；1028 投 230 只到手 162）。
# 口径「产能不限」→ 不做硬限，只在 /produce 返回里给软提示；设 0 关闭提示。
# **11-09 深夜用户口径：「那个号池不要做限制了。现在耗池，先不用做限制」→ 默认 0**：
# 连软提示也不给，界面只报当天实数（已投/板上在册），不劝、不分日建议、不拦。
# 想恢复提示就填实测值（120），提示文案与「分日建议」都在，逻辑没删。
ASSET_BOARD_DAILY_SOFT_CAP=0
# 新文案自动预取钩子编号（11-09 批 O，用户口径「以后的新文案也自动预取吧」）：
# 贴文案导入／成稿配对导入／出文案三个建候选的入口，当场跑一次取号脚本把号挂在文案上，
# 开单时自动顶进缺号槽位。取不到号**不拦导入**（号是外部动作，稿比号金贵），
# 界面照旧能手工填或点「代取」。设 false 连脚本都不碰。
ASSET_AUTO_PARK_HOOK_CODES=true
# 取号命令（参数=数量，stdout 每行一个五位编号）。留空＝界面「代取」回 501 走手工粘贴。
# 163 现网填：python3 /home/cc12703/hook_id.py
# ⚠ 容器内要能跑到它：compose 已把脚本与共享台账挂进 backend（见 docker-compose.yml），
#   否则自动预取每次都白跑一枪（现象＝导入回话里「没预取到编号」）。
ASSET_HOOK_ID_CMD=
# 板上排日按本地时区（NAS 在 CST），后端存 UTC —— 16:00~24:00 之间会错一天，
# 而 date 写错＝额度白烧且成片永久取不回（1021 实测 120 条）。
ASSET_BOARD_TZ_OFFSET_HOURS=8
# 出片实测锁死的规格（duration/resolution 是「意图」不是「承诺」）
ASSET_BOARD_OUTPUT_SECONDS=10.08
ASSET_BOARD_OUTPUT_RESOLUTION=720x1280
# ── 抽帧（11-04 批 F：审核台卡片图，纯呈现层，不参与任何业务判定）──
# 每条素材抽几张单帧（卡片左侧横排）；3 是拍板值——1 张看不出节奏，5 张卡片放不下
ASSET_FRAME_THUMB_COUNT=3
# 九宫格一张图里几帧（tile=3x3）；改非平方数要同步改 asset_frame_service.GRID_COLS
ASSET_FRAME_GRID_TILES=9
# 缩略帧宽 / 九宫格整图宽（px）
ASSET_FRAME_THUMB_WIDTH=360
ASSET_FRAME_GRID_WIDTH=1080
# 长过这个秒数的原片**不抽帧**（整集片会把 worker 钉在 ffmpeg 上）；设 0 = 关掉抽帧
ASSET_FRAME_MAX_SOURCE_SECONDS=900
# 单条 ffmpeg 命令超时（秒）：正常 2~5s，卡住的多半是坏文件
ASSET_FRAME_TIMEOUT_SECONDS=120
# 同时在跑的抽帧协程数：一批 100 个文件会一次排 100 个任务，不限流就是抢 CPU
ASSET_FRAME_CONCURRENCY=2
# 手动重抽单次条数上限：抽帧不花钱但占 CPU，同步等 20 条已经是几十秒，
# 超量要么带 async_mode=true 排后台，要么分次点
ASSET_FRAME_MAX_PER_CALL=20
# ── 图片素材（11-05 批 G：图片真收进素材库，但**只做生产输入**）──
# 图片不进反推/文案/生产/拼接四环，也不抽帧（它自己就是一张图）；四环闸门按
# asset_items.media_kind 拒它，所以这三个旋钮只影响入库，不影响任何扣费口径。
# 上传大小上限（MB）：素材库上传通道不分片，超了当场拒
ASSET_IMAGE_MAX_SIZE_MB=20
# 短边低于这个像素 → 只提醒不拒收（当角色卡会糊，但让一线自己决定）
ASSET_IMAGE_MIN_EDGE=360
# 长边超过这个像素 → 只提醒（板侧会缩，白占桶空间）
ASSET_IMAGE_MAX_EDGE=4096

# ═══════════════════════════════════════════════════════════════
# 局域网获取剧集（lan_source，剧目详情页导入局域网源剧集并进切片）
# ═══════════════════════════════════════════════════════════════
# 以下为 .env 兜底默认值；也可以在系统设置-局域网获取剧集(lan_source_config)中热更，无需重启。
# 总开关（默认 false）。开启后在剧目详情页出现「局域网获取剧集」面板。
LAN_SOURCE_ENABLED=false
# dupload cdn 源基础地址（返回 /videos/{drama}/cdn 直链的服务），默认局域网 8765
LAN_SOURCE_BASE_URL=http://192.168.1.163:8765
# 剧目清单来源（可选）：IAA 小程序管理平台基础地址（提供 /api/bg/sync/tasks 剧名清单）。
# 未配置时允许从 API 手工提交剧名清单。
LAN_SOURCE_MANAGE_BASE=
# 剧集清单接口是否带路径前缀（有的源在 {base}/videos/{drama}/cdn）
LAN_SOURCE_API_PREFIX=
# 下载超时（秒，单集拉流整体超时）
LAN_SOURCE_DOWNLOAD_TIMEOUT=900
# 独立 Celery 队列名（lan_source；并入 worker-fast 消费）
LAN_SOURCE_QUEUE=lan_source
# 未指定 project_id 时的默认归属切片项目名
LAN_SOURCE_DEFAULT_PROJECT=局域网导入
# 每集 HTTP 下载并发数（默认 2，避免打爆源服务器）
LAN_SOURCE_CONCURRENCY=2

# ═══════════════════════════════════════════════════════════════
# 推送到下载平台（dupload，对接 21:8800 dramaupload / dupload 独立服务）
# ═══════════════════════════════════════════════════════════════
# 以下为 .env 兜底默认值；也可以在系统设置-推送到下载平台(dupload_config)中热更，无需重启。
# 总开关（默认开启）。开启后剧目详情页出现「推送到下载平台」区块。
DUPLOAD_ENABLED=true
# dupload 服务基础地址
DUPLOAD_BASE_URL=http://192.168.1.21:8800
# 批量导入接口路径
DUPLOAD_IMPORT_PATH=/api/dupload/tasks
# 动作：only_download(仅下载) / upload_miniapp(上传小程序)
DUPLOAD_ACTION=only_download
# 剧目模型里素材链接(shareUrl)的字段名（默认 material_link）
DUPLOAD_SHARE_URL_FIELD=material_link
# 单次请求超时（秒）
DUPLOAD_REQUEST_TIMEOUT=30
# 可选：指定推送的 workHost（字符串，如 10.10.0.5:8765）；配置了则仅推送该主机
DUPLOAD_WORK_HOST=
# 可选：指定推送的 workHost 列表（逗号分隔，如 10.10.0.5:8765,mps.mi-von.com:25465）；
# work_host 优先；均未配置时默认拉取 dupload 全部 hosts（GET /api/dupload/hosts）逐台推送。
DUPLOAD_WORK_HOSTS=
# 可选：appSecret（按 workHost 匹配；缺省时尝试从 hosts 接口探测，否则传空串）
DUPLOAD_APP_SECRET=
# dupload 批量导入必填：cpID（下载平台侧合作方 ID）
DUPLOAD_CP_ID=

# ============ Remotion 高光混剪增强（P2）============
# 生产安全开关（参考 SPARKLE_ENABLED 思路）：默认关闭。开启后，切片启用
# remotion_mix_enabled 时才会投递 Remotion 渲染任务到 remotion 队列（worker-remotion 容器消费）。
REMOTION_ENABLED=false
# Remotion 渲染容器内 render.js 入口路径（worker-remotion 容器内固定 /remotion/dist/render.js）
# REMOTION_RENDER_SCRIPT=/remotion/dist/render.js
# Remotion 渲染临时目录（源视频/封面/props/产物落盘）
# REMOTION_TMP_DIR=/tmp/remotion
# Remotion 渲染超时守护巡检间隔（秒）
# REMOTION_STALE_INTERVAL_SECONDS=300
# Remotion 渲染任务超时阈值（秒），超过仍 rendering 视为卡死并回写 failed
# REMOTION_RENDER_TIMEOUT_SECONDS=3600

# ============ 看板指标自动导入（ISSUE #366）============
# 163 data-update 采集系统产出 board_data.json（每 2 小时一轮，45 个视频号账号）。
# 宿主机目录只读挂到容器 /data/board，celery beat 每 2 小时（整点后 40 分）自动同步到 video_metrics。
# 文件缺失/解析失败只 warning 跳过本轮，不重试不告警。
BOARD_DATA_JSON_PATH=/data/board/board_data.json
# 导入任务队列（worker-fast 已订阅 metrics）
BOARD_METRICS_QUEUE=metrics

# ============ 批 M（评审一·P2）补齐：config.py 有、示例缺的 30 个字段 ============
# 原则：有默认值的照抄默认（注释=不改就这个值）；密钥类给空值＋说明，绝不写真值。

# ---- MinIO 桶名（各产物分桶；桶由部署侧预建，后端不建桶）----
MINIO_BUCKET_RAW=raw-footage
MINIO_BUCKET_SLICED=sliced
MINIO_BUCKET_PREVIEWS=previews
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_SCREENSHOTS=publish-screenshots

# ---- autoclip 服务地址（出文案/提示词展开走它）----
AUTOCLIP_URL=http://autoclip:8000/api/v1

# ---- 大文件上传（导入/素材原片）----
UPLOAD_CHUNK_SIZE=5242880            # 5MB，分片大小
UPLOAD_TEMP_DIR=/tmp/uploads
UPLOAD_MAX_SIZE=53687091200          # 50GB，单文件上限
# 多端同传时按秒级差异检测去重（默认关）
MULTI_UPLOAD_SECOND_DIFF_DETECT=false

# ---- 服务监听（compose/裸机一致用 8080）----
APP_HOST=0.0.0.0
APP_PORT=8080

# ---- 浏览器宿主（RPA/发布侧）----
CHROME_DEBUG_HOST=localhost
PLAYWRIGHT_IDLE_TIMEOUT=300          # 秒

# ---- 打码/改写侧 ----
WATERMARK_REMOVE_MASK_SCRIPT=remove_mask_remover.py
WATERMARK_MAX_DURATION=3600          # 秒，超过不处理
DOUBAO_REWRITE_WAIT_SECONDS=30

# ---- 微信下载陈旧任务巡检 ----
WECHAT_DL_STALE_INTERVAL_SECONDS=300
WECHAT_DL_STALE_TIMEOUT_SECONDS=3600

# ---- 飞书多维表格对接（剧名库/排期；不接就全留空，功能自动旁路）----
FEISHU_SPREADSHEET_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=                   # ⚠️ 真值只进 .env / 部署面板，别提交
FEISHU_DRAMA_COL=剧目名称
FEISHU_THEATER_COL=剧场
FEISHU_ROSTER_CACHE_DIR=/app/media/pingyue

# ---- Remotion 渲染队列 ----
REMOTION_OUTPUT_PREFIX=remotion
REMOTION_QUEUE=remotion

# ---- 素材库回源解析任务守护（批 I 起）----
ASSET_ANALYZE_JOB_POLL_SECONDS=10.0
ASSET_ANALYZE_JOB_TIMEOUT_MINUTES=30.0
ASSET_ANALYZE_FAST_FAIL_RETRY_SECONDS=120.0

# ---- A′ 按运营隔离（2026-11-08，11-09 用户改口径）----
# 自审自投闸门：自己过审的候选自己投产要不要拦。
# 11-09 起 **默认 true＝放开**（一人多角是常态，别再挡路）；显式设 false 才拦，
# 放开时每次自审自投仍逐条写豁免审计（查得到谁自己审自己投）。
ASSET_SELF_PRODUCE_ALLOWED=true
