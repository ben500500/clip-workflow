# =============================================================================
# Clip Workflow - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置
# =============================================================================
# cp .env.example .env
# =============================================================================

# ==================== 通用配置 ====================
# 应用名称
APP_NAME=Clip Workflow
# 运行环境: development / production / testing
APP_ENV=development
# 调试模式
DEBUG=true
# 密钥（请务必修改为随机字符串）
SECRET_KEY=change-this-to-a-random-secret-key
# 允许的主机名（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== PostgreSQL 数据库 ====================
POSTGRES_DB=clipworkflow
POSTGRES_USER=clipworkflow
# 必填：请替换为强随机密码（如 openssl rand -base64 24）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# 必填：请与 POSTGRES_PASSWORD 保持一致
DATABASE_URL=postgresql+asyncpg://clipworkflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/clipworkflow

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
# 必填：请替换为强随机密码
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Redis 连接 URL（通用）
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0
# Celery 消息代理
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/1
# Celery 结果后端
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/2

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
# 必填：请替换为强随机密码
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_ACCESS_KEY=minioadmin
# 必填：请与 MINIO_ROOT_PASSWORD 保持一致
MINIO_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=clipworkflow
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

# ==================== 服务端口配置 ====================
NGINX_PORT=80
BACKEND_PORT=8001
FRONTEND_PORT=3000
AUTOCLIP_PORT=8000

# ==================== AutoClip 配置 ====================
# AutoClip 监听地址
AUTOCLIP_HOST=0.0.0.0
# AutoClip 工作模式: api / worker
AUTOCLIP_MODE=api
# 阿里云 DashScope API Key（用于 AI 剪辑 + Seedance 提示词生成 + 短剧发布素材生成）
DASHSCOPE_API_KEY=
# 默认 AI 模型
DEFAULT_AI_MODEL=qwen-vl-max
# AutoClip 实际调用的大模型（选点 + Seedance 提示词生成 + 发布素材生成共用；docker-compose 默认 qwen-plus）
API_MODEL_NAME=qwen-plus
# ASR 语音识别方式: aliyun_speech（默认，需 API Key） / whisper（本地 faster-whisper）
AUTOCLIP_ASR_METHOD=aliyun_speech
# ASR 字幕缓存复用开关（默认开启：同一视频再次 AI 选点直接复用转写结果，避免重复转写）
AUTOCLIP_ASR_CACHE=true

# ==================== Celery 配置 ====================
# Celery Worker 并发数
CELERY_WORKER_CONCURRENCY=4
# Celery 任务序列化方式
CELERY_TASK_SERIALIZER=json
# Celery 结果序列化方式
CELERY_RESULT_SERIALIZER=json
# Celery 时区
CELERY_TIMEZONE=Asia/Shanghai
# 是否启用 Celery 定时任务
CELERY_BEAT_SCHEDULE_ENABLED=true

# ==================== 切片 Worker 配置 ====================
# 切片分发引擎：worker（Redis Stream / Go Worker）或 celery（回退）
SLICE_ENGINE=worker
# Worker 回调/上传 URL 的基础地址
# - 单机 Docker 部署：http://backend:8080（容器网络内）
# - 远程物理机部署：配置为后端可被 Worker 访问的地址，如 http://服务器IP:8001
WORKER_CALLBACK_BASE_URL=http://backend:8080
# Worker 节点 CPU 资源分配比例（%，默认 50）：切片时限制 ffmpeg 编码线程数，
# 避免切片任务占满整机 CPU，影响同机其它服务。1~100 之间取值。
CPU_PERCENT=50
# Worker 任务超时（秒）
SLICE_TASK_TIMEOUT_SECONDS=7200
# Worker 失败重试次数
SLICE_WORKER_MAX_RETRIES=2
# Worker 失败重试延迟（秒）
SLICE_WORKER_RETRY_DELAY=30

# ==================== 日志配置 ====================
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=/app/logs/app.log
# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== 媒体文件配置 ====================
# 媒体文件存储方式: local / minio
MEDIA_STORAGE=minio
# 本地媒体文件路径（当 MEDIA_STORAGE=local 时使用）
MEDIA_DIR=/app/media
# 上传文件大小限制（字节）
MAX_UPLOAD_SIZE=524288000
# 支持的视频文件扩展名
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm
# 支持的音频文件扩展名
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.aac,.flac,.ogg

# ==================== CORS 配置 ====================
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1

# ==================== API 限流配置 ====================
# API 请求速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60
# 上传接口限流
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# ==================== RPA 自动发布配置 ====================
# Chrome 调试端口
CHROME_DEBUG_PORT=9222
# RPA 调试端口映射
RPA_DEBUG_PORT=9222
# 发布前是否需要人工确认
RPA_REQUIRE_MANUAL_CONFIRM=true
# 两次发布最小间隔（秒）
RPA_MIN_INTERVAL_SECONDS=300
# 每日最大发布数
RPA_MAX_DAILY_PUBLISH=20
# ==================== 安全认证（二期） ====================
# JWT 密钥（请务必修改为随机字符串）
JWT_SECRET=change-this-to-a-random-jwt-secret
# access_token 有效期（分钟），默认 30
JWT_EXPIRE_MINUTES=30
# refresh_token 有效期（天），默认 7
JWT_REFRESH_EXPIRE_DAYS=7
# RPA Cookie 加密密钥（AES-256/Fernet），未配置时回退 JWT_SECRET
COOKIE_ENCRYPT_KEY=

# ==================== 监控告警（三期） ====================
# 钉钉机器人 Webhook 地址（用于推送告警消息），留空则不推送
DINGTALK_WEBHOOK=
# 告警轮询间隔（秒），默认 300
ALERT_CHECK_INTERVAL_SECONDS=300

# ==================== 性能优化（三期） ====================
# 数据归档：video_metrics 等看板数据超过该天数自动归档（默认 90）
METRICS_ARCHIVE_DAYS=90
# MinIO 生命周期：对象未访问超过该天数转低频存储（默认 90）
MINIO_LIFECYCLE_DAYS=90

# ==================== 去水印功能（v4） ====================
# 去水印输出存储桶（处理后视频）
MINIO_BUCKET_WATERMARK=watermark-output
# 去水印源视频存储桶
MINIO_BUCKET_WATERMARK_RAW=watermark-raw
# remove-ai-watermarks CLI 可执行文件（pip 安装后为 remove-ai-watermarks）
WATERMARK_RAIW_CLI=remove-ai-watermarks
# Seedance 去水印脚本文件名（位于 ENGINES_DIR 下；容器内 /app/engines/seedance_watermark_remover.py）
WATERMARK_SEEDANCE_SCRIPT=seedance_watermark_remover.py
# seedance_wm（remover 仓库 5 阶段流水线）执行入口脚本（位于 ENGINES_DIR 下）
WATERMARK_SEEDANCE_WM_SCRIPT=seedance_wm_runner.py
