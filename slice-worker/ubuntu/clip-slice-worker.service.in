# Clip Workflow - Slice Worker systemd 服务（Ubuntu）
# 安装后 Worker 随系统自启，崩溃自动重启；通过 journalctl 查看日志。
#
# 由 deploy_ubuntu.sh 生成并安装到 /etc/systemd/system/。
# 占位符 __INSTALL_DIR__ 会在部署时替换为实际安装目录。

[Unit]
Description=Clip Workflow Slice Worker Node
Documentation=https://cnb.cool/ben500500/clip-workflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 后台模式（--no-tui），输出到 journald
ExecStart=__INSTALL_DIR__/slice-worker --config __INSTALL_DIR__/worker.json --no-tui
WorkingDirectory=__INSTALL_DIR__
# 崩溃后自动重启
Restart=always
RestartSec=5
# 资源限制
LimitNOFILE=65536
# 环境变量（如需要可通过 /etc/clip-worker.env 覆盖，此处不引用）

[Install]
WantedBy=multi-user.target
